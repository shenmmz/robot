# ============================================================
# 舵机指令综合验证脚本（2026-06-16，全部使用新格式 SERVO(ch=ang:T<ms>)）
# ============================================================
# 本脚本系统性地验证 ServoController 的所有控制模式：
#   - 时间模式（ms，仿 KPZ32 出厂协议）：推荐格式
#   - 短距离单帧直发（≤ 30°）
#   - 长距离软插值（> 30°）
#   - 多路独立时间（每路 T 可不同）
#   - 边界值（T=0、T<20、T=30000）
#
# 用例之间用 DELAY 隔离，避免软插值 tick 重叠；
# 短距离用例用 DELAY(100) 等物理到位；长距离用例 DELAY = 期望时间 + 500ms 余量。
#
# 测试硬件：6 路 PWM 舵机（QD-6PWM-V2.0 协议，通道 0-5）
# 测量方法：在每个用例前后用 PRINT 输出开始/结束时间，
#          对比期望到位时间与实际到位时间，误差应 < 200ms。
# ============================================================

PRINT("===== [A] 时间模式：单路基本测试 =====")

# ---- A1: 长时间（9 秒）到 90°，验证长距离软插值 ----
PRINT("[A1] 时间模式 T9000ms 到 90°（应约 9 秒）")
SERVO(0=90:T9000)
DELAY(9500)

# ---- A2: 短时间（1.5 秒）到 0°，验证快速长距离 ----
PRINT("[A2] 时间模式 T1500ms 到 0°（应约 1.5 秒）")
SERVO(0=0:T1500)
DELAY(2000)

# ---- A3: 中等时间（3 秒）到 90°，验证中等时长 ----
PRINT("[A3] 时间模式 T3000ms 到 90°（应约 3 秒）")
SERVO(0=90:T3000)
DELAY(3500)

# ---- A4: 短距离 10°（应单帧直发，瞬时到位） ----
PRINT("[A4] 短距离 10° + T2000ms（应单帧直发，瞬时）")
SERVO(0=100:T2000)
DELAY(100)

# ---- A5: 临界距离 30°（阈值边界测试） ----
PRINT("[A5] 临界距离 30° + T2000ms（阈值边界测试）")
SERVO(0=130:T2000)
DELAY(2000)


PRINT("===== [B] 时间模式：单路基本测试（重复验证） =====")

# ---- B1: 短时间（1 秒）到 0° ----
PRINT("[B1] 时间模式 T1000ms 到 0°（应约 1 秒）")
SERVO(0=0:T1000)
DELAY(1500)

# ---- B2: 中等时间（2 秒）到 90° ----
PRINT("[B2] 时间模式 T2000ms 到 90°（应约 2 秒）")
SERVO(0=90:T2000)
DELAY(2500)

# ---- B3: 长时间（5 秒）到 0° ----
PRINT("[B3] 时间模式 T5000ms 到 0°（应约 5 秒）")
SERVO(0=0:T5000)
DELAY(5500)


PRINT("===== [C] 边界值测试 =====")

# ---- C1: 时间 = 0（应单帧直发，瞬时到位） ----
PRINT("[C1] 时间模式 T0（应单帧直发，瞬时）")
SERVO(0=45:T0)
DELAY(100)

# ---- C2: 时间 = 10ms（< 20ms 应单帧直发，对齐 KPZ32 T<20 行为） ----
PRINT("[C2] 时间模式 T10ms（<20 应单帧直发，瞬时）")
SERVO(0=90:T10)
DELAY(100)

# ---- C3: 时间 = 20ms（临界值，应走 1 tick 软插值） ----
PRINT("[C3] 时间模式 T20ms（临界值，1 tick 软插值）")
SERVO(0=135:T20)
DELAY(200)

# ---- C4: 时间 = 100ms（1 tick 软插值，最短非临界） ----
PRINT("[C4] 时间模式 T100ms（1 tick 软插值）")
SERVO(0=180:T100)
DELAY(300)

# ---- C5: 极小角度 + 长时间（小步长验证） ----
PRINT("[C5] 极小角度 5° + 长时间 T2000ms（小步长验证）")
SERVO(0=170:T2000)
DELAY(2500)


PRINT("===== [D] 多路独立时间模式 =====")

# ---- D1: 第 0 路时间 2 秒，第 1 路时间 3 秒（不同时间并发） ----
PRINT("[D1] 多路独立：PWM0 时间 2s，PWM1 时间 3s")
SERVO(0=90:T2000, 1=90:T3000)
DELAY(3500)   # 等最慢的到位（PWM0 应在 2s 内到，PWM1 应在 3s 内到）

# ---- D2: 全部 6 路不同时间（每路独立 T） ----
PRINT("[D2] 6 路独立时间 T1s/T3s/T2s/T6s/T3s/T12s")
SERVO(0=0:T1000, 1=180:T3000, 2=0:T2000, 3=180:T6000, 4=0:T3000, 5=180:T12000)
DELAY(12500)   # 等 PWM5 到位（12s） + 余量

# ---- D3: 同一路不同时长（验证 totalTicks 独立性） ----
PRINT("[D3] 同一路多次不同时间：T500ms / T1500ms / T3000ms")
SERVO(0=0:T500)
DELAY(800)
SERVO(0=90:T1500)
DELAY(1800)
SERVO(0=0:T3000)
DELAY(3300)


PRINT("===== [E] 全 6 路并发：时间模式 =====")

# ---- E1: 6 路相同时间（应同步到位） ----
PRINT("[E1] 6 路相同时间 T2000ms（应同步）")
SERVO(0=90:T2000, 1=90:T2000, 2=90:T2000, 3=90:T2000, 4=90:T2000, 5=90:T2000)
DELAY(2500)

# ---- E2: 6 路不同时间（最慢的应决定总时长） ----
PRINT("[E2] 6 路不同时间 T500ms ~ T5000ms")
SERVO(0=0:T500, 1=45:T1000, 2=90:T1500, 3=135:T2000, 4=0:T3000, 5=180:T5000)
DELAY(5500)


PRINT("===== [F] 全 6 路并发：不同时间梯次 =====")

# ---- F1: 6 路不同时间（时间递增 1.5s~4s） ----
PRINT("[F1] 6 路不同时间 T1500ms ~ T4000ms")
SERVO(0=0:T1500, 1=0:T2000, 2=0:T2500, 3=0:T3000, 4=0:T3500, 5=0:T4000)
DELAY(4500)   # 等最慢的到位（4s） + 余量


PRINT("===== [G] 特殊场景 =====")

# ---- G1: 时间模式 + 短距离（短距离应忽略时间参数） ----
PRINT("[G1] 短距离 10° + T5000ms（应单帧直发，不等 5 秒）")
SERVO(0=10:T5000)
DELAY(100)   # 如果忽略时间参数，这里 100ms 就到位

# ---- G2: 角度 = 0 到 0（无移动，应瞬时） ----
PRINT("[G2] 同角度 90→90（无移动）")
SERVO(0=90:T2000)
DELAY(100)

# ---- G3: 时间超限警告测试（> 30000ms 应被截断为 30000ms） ----
# 注意：执行耗时 30 秒，仅在需要测试上限时使用
# PRINT("[G3] 时间超限 T60000ms（应被截断为 30000ms）")
# SERVO(0=180:T60000)
# DELAY(30500)


PRINT("===== [H] 回中位 + 结束 =====")

# ---- H1: 全部 6 路回中位（90°），各用 1 秒 ----
PRINT("[H1] 6 路回中位（90°，T1000ms）")
SERVO(0=90:T1000, 1=90:T1000, 2=90:T1000, 3=90:T1000, 4=90:T1000, 5=90:T1000)
DELAY(1500)

PRINT("===== 舵机验证脚本执行完毕 =====")
