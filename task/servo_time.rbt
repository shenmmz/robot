# ---- 用例 1: 单路 T2000ms（应耗时约 2 秒） ----
SERVO(3=90:T2000)

# ---- 用例 2: 单路 T3000ms（应耗时约 3 秒） ----
SERVO(4=0:T3000)

# ---- 用例 3: 3/4/5 并发 T3000/T1500/T2000（应耗时约 3 秒） ----
SERVO(3=0:T3000, 4=180:T1500, 5=90:T2000)

# ---- 用例 4: 6 路并发 T1000~T3500（应耗时约 3.5 秒） ----
SERVO(0=180:T1000, 1=0:T2000, 2=90:T1500, 3=135:T2500, 4=45:T3000, 5=170:T3500)

# ---- 用例 5: 极短 T10ms（应单帧直发，瞬时） ----
SERVO(3=45:T10)

# ---- 用例 6: T0（应单帧直发，瞬时） ----
SERVO(4=135:T0)

# ---- 用例 7: T20ms 临界值（1 tick 软插值，应耗时约 100ms） ----
SERVO(5=90:T20)

# ---- 用例 8: 短距离 + T5000ms（应忽略时间，瞬时） ----
SERVO(3=100:T5000)

# ---- 用例 9: T5000ms 长时间（应耗时约 5 秒） ----
SERVO(4=180:T5000)

# ---- 用例 10: 3/4/5 同步 T2000ms（应耗时约 2 秒） ----
SERVO(3=90:T2000, 4=90:T2000, 5=90:T2000)

PRINT("舵机时间模式验证脚本（通道 3/4/5）执行完毕")
