                                            <item>
                                                <widget class="QPlainTextEdit" name="progEditor">
                                                    <property name="styleSheet">
                                                        <string>QPlainTextEdit{
  background:#1e1e2e;color:#d4d4d4;border:1px solid #d0d5dd;
  border-radius:6px;font-family:Consolas,'Microsoft YaHei UI';font-size:12px;
  padding:8px;selection-background-color:#264f78;
}</string>
                                                    </property>
                                                    <property name="tabChangesFocus">
                                                        <bool>false</bool>
                                                    </property>
                                                    <property name="plainText">
                                                        <string>-- R06 运动脚本示例
HOME()
WAIT_IDLE()
MOVEJ(Target1, speed=40)
WAIT_IDLE()
MOVEL(Target2, speed=30)
MOVEL(Target3, speed=30)
MOVEL(Target4, speed=20)
MOVEL(Target5, speed=20)
MOVEL(Target2, speed=30)
PRINT(&quot;轨迹完成&quot;)
